#!/bin/sh
# Local pre-push gate: runs the same checks as CI before code leaves your machine.
# Install once (Git Bash): cp scripts/pre-push .git/hooks/pre-push
# Bypass (not recommended): git push --no-verify
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "[pre-push] Backend: dotnet test"
dotnet test Backend/Backend.slnx --nologo -v minimal

FRONTEND_CHANGED=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -z "${local_sha:-}" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    base="$(git merge-base HEAD origin/main 2>/dev/null || true)"
    range="${base:-HEAD}..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  if git diff --name-only "$range" 2>/dev/null | grep -q '^frontend/'; then
    FRONTEND_CHANGED=1
  fi
done

if [ "$FRONTEND_CHANGED" = "1" ]; then
  echo "[pre-push] Frontend changes detected: lint"
  npm run lint --prefix frontend
else
  echo "[pre-push] No frontend changes, skipping lint"
fi
