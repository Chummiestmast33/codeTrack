# Copy to .env and fill real values. Never commit .env.
# Local Docker database (see docker-compose.yml)
POSTGRES_USER=codetrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codetrack
POSTGRES_PORT=5432
API_PORT=8080

# Pending: exact allowed email domain (D-02). Leave empty until defined.
ALLOWED_EMAIL_DOMAIN=

# JWT signing secret, at least 32 characters (RNF-14: never commit real secrets)
JWT_SECRET=change-me-to-at-least-32-characters-long
JWT_ISSUER=codetrack
JWT_AUDIENCE=codetrack
JWT_EXPIRY_MINUTES=60

# --- Official report header (RN-08, never commit real values) ---
# Hierarchical names map with __ in .NET, e.g. Reports__ProjectName.
# REPORT_PROJECT_NAME=
# REPORT_PERIOD=
# REPORT_RESPONSIBLE=
# REPORT_ADVISOR=

# --- File storage (Supabase Storage target, future use) ---
# Hierarchical names map with __ in .NET, e.g. Storage__Endpoint.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_BUCKET=submissions
# SUPABASE_SERVICE_KEY=
# STORAGE_UPLOAD_EXPIRY_MINUTES=15
# STORAGE_DOWNLOAD_EXPIRY_MINUTES=60

# --- Production (Supabase) ---
# Use the DIRECT connection (port 5432) for `dotnet ef database update`.
# The pooler (port 6543) may be used at runtime.
# Example: Host=db.xxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=...;SSL Mode=Require
# ConnectionStrings__DefaultConnection=
