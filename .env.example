# Copy to .env and fill real values. Never commit .env.
# Local Docker database (see docker-compose.yml)
POSTGRES_USER=codetrack
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codetrack
POSTGRES_PORT=5432
API_PORT=8080

# Pending: exact allowed email domain (D-02). Leave empty until defined.
ALLOWED_EMAIL_DOMAIN=

# JWT signing secret, at least 32 characters (RNF-14: never commit real secrets)
JWT_SECRET=change-me-to-at-least-32-characters-long
JWT_ISSUER=codetrack
JWT_AUDIENCE=codetrack
JWT_EXPIRY_MINUTES=60

# --- Official report header (RN-08, never commit real values) ---
# Hierarchical names map with __ in .NET, e.g. Reports__ProjectName.
# REPORT_PROJECT_NAME=
# REPORT_PERIOD=
# REPORT_RESPONSIBLE=
# REPORT_ADVISOR=

# --- Initial administrator bootstrap (created once at startup if missing) ---
# ADMIN_CONTROL_NUMBER=
# ADMIN_FULL_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- File storage (S3-compatible: Supabase Storage, R2, MinIO) ---
# Hierarchical names map with __ in .NET, e.g. Storage__Endpoint.
# S3_ENDPOINT=https://xxxx.storage.supabase.co/storage/v1/s3
# S3_REGION=us-west-2
# S3_BUCKET=submissions
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# STORAGE_UPLOAD_EXPIRY_MINUTES=15
# STORAGE_DOWNLOAD_EXPIRY_MINUTES=60

# --- Frontend URLs (QR links and browser CORS) ---
# QR_FRONTEND_BASE_URL=http://localhost:5173
# CORS_ALLOWED_ORIGIN_0=http://localhost:5173
# CORS_ALLOWED_ORIGIN_1=http://localhost:5199
# CORS_ALLOWED_ORIGIN_2=http://localhost:8080

# --- Production (Supabase): copy each string from the dashboard Connect dialog ---
# Migrations (`dotnet ef database update --connection "<directa>"`: DIRECT, user postgres.
# Falls back to the session pooler below if your network lacks IPv6 (it also accepts DDL).
# Example: Host=db.xxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=...;SSL Mode=Require
# Runtime (Render container): SHARED POOLER in SESSION mode (:5432, supports
# prepared statements; transaction mode :6543 does NOT). User postgres.xxxx.
# Example: Host=aws-0-us-west-2.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.xxxx;Password=...;SSL Mode=Require
# ConnectionStrings__DefaultConnection=
